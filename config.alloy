logging {
  level = "info"
}

faro.receiver "rum" {
  server {
    listen_address = "0.0.0.0"
    listen_port = 12347
    cors_allowed_origins = ["http://34.207.177.215:8080"]
  }

  log_format = "json"

  extra_log_labels = {
    job = "faro",
  }

  sourcemaps {
    download = false
  }

  output {
    logs = [loki.write.local.receiver]
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
